# =====================================================
# ✅ Core Rewrite Rules (Router + Trailing Slash Fix + AJAX Support)
# =====================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Remove trailing slashes (except root)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # =====================================================
    # 🔒 Block direct PHP access (except index.php, router.php, and AJAX endpoints)
    # =====================================================
    RewriteCond %{REQUEST_URI} \.php$ [NC]
	RewriteCond %{REQUEST_URI} !/(index|router)\.php$ [NC]
	RewriteCond %{REQUEST_URI} !^/src/ajax/ [NC]
	RewriteRule ^.*$ /404.php [L]

    # =====================================================
    # ⚙️ Allow AJAX routes (route them via router.php)
    # =====================================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^src/ajax/(.*)$ router.php [L,QSA]

    # =====================================================
    # 🔁 Route all non-file/non-folder requests to router.php
    # =====================================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ router.php [L]
</IfModule>

# =====================================================
# ⚙️ Caching Rules
# =====================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Images (cache 1 month)
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"

    # Icons (cache 1 year)
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JS (cache 1 week)
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"

    # Manifest (cache 1 day)
    ExpiresByType application/manifest+json "access plus 1 day"

    # Fonts (cache 1 year)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# =====================================================
# 🧠 Smart Cache-Control Headers
# =====================================================
<IfModule mod_headers.c>
    # ❌ No caching for backend, PHP, AJAX (except manifest.json)
    <If "(%{REQUEST_URI} =~ m#^/src/ajax/# || %{REQUEST_URI} =~ m#\.php$# || %{REQUEST_URI} =~ m#\.json$#) && %{REQUEST_URI} !~ m#manifest\.json#">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set Vary "Cookie"
    </If>

    # ✅ Cache manifest.json (cache 1 day)
    <If "%{REQUEST_URI} =~ m#manifest\.json#">
        Header always set Cache-Control "public, max-age=86400"
    </If>

    # ✅ Cache static CSS/JS/fonts
    <If "%{REQUEST_URI} =~ m#^/(css|js)/.*\.(css|js)$#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # ✅ Cache images
    <If "%{REQUEST_URI} =~ m#^(/images/.*|/[^/]+\.(jpg|jpeg|png|gif|webp|svg|ico))$#">
        Header always set Cache-Control "public, max-age=2592000"
    </If>

    # Enable CORS for fonts
    <FilesMatch "\.(woff2|woff|ttf|otf)$">
        Header always set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # =====================================================
    # 🔒 Security Headers
    # =====================================================
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HSTS (enable only if using HTTPS)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    Header always set Content-Security-Policy "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; img-src * data: blob:; font-src * data:; connect-src *; frame-src *; object-src 'none';"
</IfModule>

# =====================================================
# 🌀 Compression (GZIP + Brotli)
# =====================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
    BrotliCompressionQuality 6
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

RewriteEngine On

# =====================================================
# 🧩 Prevent Directory Listing
# =====================================================
Options -Indexes

# =====================================================
# 🧭 Custom Error Pages
# =====================================================
ErrorDocument 404 /404
ErrorDocument 403 /404

