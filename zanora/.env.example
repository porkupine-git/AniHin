# Database Connection
DB_HOST=localhost
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=your_db_name

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=your_redis_password

# Cloudflare Turnstile CAPTCHA Keys
CF_TURNSTILE_SITE_KEY=your_turnstile_site_key
CF_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Brevo SMTP Configuration
BREVO_API_KEY=your_brevo_api_key
SMTP_EMAIL=noreply@yourdomain.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_PORT=587
SMTP_SECURE=tls

# Website Metadata
WEBSITE_TITLE=Zanora
WEBSITE_URL=https://yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com
VERSION=1.0.2

# Social Links
DISCORD_URL=https://discord.gg/your_discord_invite
REDDIT_URL=#
TELEGRAM_URL=https://t.me/your_telegram_channel
INSTAGRAM_URL=#

# APIs
ZPI_API_URL=https://your_custom_api_domain.com/api
PLAYER_URL=https://player.yourdomain.com

# Assets
BANNER_IMAGE=/images/capture.png?v=1
WEBSITE_LOGO=/images/logo.png?v=1.2
FAVICON_PATH=/favicon.ico
FAVICON_PATH_SVG=/favicon.svg

# Rate Limiting
DISABLE_EMAIL_RATE_LIMIT=false
DISABLE_PASSWORD_RESET_RATE_LIMIT=false

# AniList OAuth Credentials
ANILIST_CLIENT_ID=your_anilist_client_id
ANILIST_CLIENT_SECRET=your_anilist_client_secret
ANILIST_REDIRECT_URI=https://yourdomain.com/auth/anilist/callback

# Discord OAuth Credentials
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback
